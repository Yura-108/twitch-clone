# ---------- dependencies ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- build output ----------
dist/
build/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ---------- generated ----------
# Prisma client is regenerated by `yarn db:generate`.
# Note: apps/backend/src/core/graphql/schema.gql is deliberately NOT ignored —
# it is the API contract the frontend generates its types from.
apps/backend/generated/

# ---------- environment ----------
.env
.env.*
!.env.example

# ---------- runtime uploads ----------
# media/ holds committed seed images; uploads/ is user-generated at runtime.
apps/backend/uploads/

# ---------- logs ----------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- tests ----------
coverage/
.nyc_output/

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- IDE ----------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---------- AI tooling ----------
# Skill trees are vendored copies restored from skills-lock.json (committed).
# .claude/skills and .windsurf/skills are junctions into .agents/skills.
# NB: a pattern with a slash in the middle is anchored to this file's directory,
# so these need the **/ prefix to also match inside apps/*.
.agents/
.windsurf/
**/.claude/skills/
# contains a plaintext test password in its allowlist entries
**/.claude/settings.local.json

# ---------- misc ----------
.vercel
.temp
.tmp
