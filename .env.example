NODE_ENV='development'

# ---------- Backend ----------
APPLICATION_PORT=4000
APPLICATION_URL="http://localhost:${APPLICATION_PORT}"
GRAPHQL_PREFIX='/graphql'
ALLOWED_ORIGIN='http://localhost:3000'

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIES_SECRET='change-me'

SESSION_SECRET='change-me'
SESSION_NAME='session'
SESSION_DOMAIN='localhost'
SESSION_MAX_AGE='30d'
SESSION_HTTP_ONLY=true
SESSION_SECURE=false
SESSION_FOLDER='sessions:'

# ---------- Postgres (also consumed by docker-compose.yml) ----------
POSTGRES_USER='postgres'
POSTGRES_PASSWORD='postgres'
POSTGRES_HOST='localhost'
# Host-side port. Kept off the default 5432 so it does not clash with a
# locally installed Postgres. docker-compose maps ${POSTGRES_PORT}:5432.
POSTGRES_PORT='5433'
POSTGRES_DATABASE='twitch'
POSTGRES_URI="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}"

# ---------- Redis (also consumed by docker-compose.yml) ----------
REDIS_PASSWORD='change-me'
REDIS_HOST='localhost'
REDIS_PORT='6379'
REDIS_URI="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}"

# ---------- Mail (SMTP) ----------
# Port 465 speaks TLS immediately; 587 and 2525 start plain and upgrade via
# STARTTLS. The code derives `secure` from the port, so just set the right one.
# Empty values are rejected at startup — see requireEnv().
MAIL_HOST=''
MAIL_PORT='587'
MAIL_LOGIN=''
MAIL_PASSWORD=''

# ---------- Frontend ----------
# Inlined into the client bundle at build time — never put secrets here.
NEXT_PUBLIC_SERVER_URL='http://localhost:4000'
NEXT_PUBLIC_GRAPHQL_URL='http://localhost:4000/graphql'
NEXT_PUBLIC_WEBSITE_URL='http://localhost:3000'
