{
	"name": "@twitch/backend",
	"version": "0.0.1",
	"description": "Twitch clone API — NestJS + GraphQL + Prisma + Redis",
	"author": "",
	"private": true,
	"license": "MIT",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"db:generate": "prisma generate",
		"db:push": "prisma db push",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"storage:check": "tsx scripts/check-storage.ts"
	},
	"dependencies": {
		"@apollo/server": "^5.5.1",
		"@as-integrations/express5": "^1.1.2",
		"@aws-sdk/client-s3": "^3.1116.0",
		"@nestjs-modules/mailer": "^2.3.7",
		"@nestjs/apollo": "^13.4.2",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.0.1",
		"@nestjs/graphql": "^13.4.2",
		"@nestjs/mapped-types": "*",
		"@nestjs/platform-express": "^11.0.1",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@types/qrcode": "^1.5.6",
		"@types/uuid": "^11.0.0",
		"argon2": "^0.45.1",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"connect-redis": "^8.1.0",
		"cookie-parser": "^1.4.7",
		"device-detector-js": "^3.0.3",
		"dotenv": "^17.4.2",
		"dotenv-expand": "^1000.0.0",
		"express-session": "^1.19.0",
		"geoip-lite": "^2.0.3",
		"graphql": "^17.0.2",
		"graphql-upload-ts": "^2.2.0",
		"heic-convert": "^2.1.0",
		"hi-base32": "^0.5.1",
		"i18n-iso-countries": "^7.14.0",
		"ioredis": "^6.0.0",
		"otpauth": "^9.5.1",
		"pg": "^8.22.0",
		"qrcode": "^1.5.4",
		"react-email": "6.9.2",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"sharp": "^0.35.3",
		"tsx": "^4.23.7",
		"uuid": "^14.0.2"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.0",
		"@types/express-session": "^1.19.0",
		"@types/geoip-lite": "^1.4.4",
		"@types/heic-convert": "^2.1.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.0.0",
		"@types/pg": "^8.20.4",
		"@types/supertest": "^7.0.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.2",
		"globals": "^17.0.0",
		"jest": "^30.0.0",
		"prisma": "^7.9.1",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
